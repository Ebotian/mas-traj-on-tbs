# Python tooling
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-*/
.uvcache/
.uv/

# E* state roots (keyed by candidate content + theta, reproducible)
**/e-star-state/

# Pinned upstream checkouts and nested repos: the version pins are recorded in
# a0/tasks/circle-packing/EID_INPUTS.json, so the trees themselves stay out.
a0/tasks/circle-packing/upstream/
a0/runtimes/loreley/checkout/
**/.codex-driver-home/

# Repo caches and materialized candidate workspaces (reproducible from C*)
**/.repo_cache/
**/cache/checkouts/
**/workspace/
**/worktree/

# Merged trace streams: duplicated from the three per-kind files, and
# `trace_validate.py validate-run` recomposes them when absent.
*.all.jsonl

# Independent-verification byte copies of sibling workstreams
a0/verify/runtimes/
a0/verify/tasks/
a0/verify/contract/
a0/verify/conformance/
a0/verify/confrun/

# Full-filesystem snapshot manifests (they hash ignored trees such as venvs)
a0/verify/out/snap_*.json

# Container data
**/pgdata/
**/redis-data/

# Scratch
**/tmp/

# Loreley LLM round: worker clones/worktrees (recreated per round)
a0/runtimes/loreley/llm-round/repo/
a0/runtimes/loreley/llm-round/worker-repo/
a0/runtimes/loreley/llm-round/worker-repo-worktrees/

# Scratch git worktrees/materialized trees created by probe runs
**/*-work/
a0/notes/**/work/

# related_files: a reference corpus of plans, reviews and their sources. Text
# only, as a whitelist, because the folder accumulates downloaded papers and a
# blacklist would admit the next binary silently. Directories stay re-included so
# the text patterns below can be reached; the PDFs stay out, both kinds of them.
# pdf/ holds what `make` rebuilds from the .typ sources and `make clean` deletes.
# literature/ holds papers with no source here at all, so nothing can rebuild
# them. To track a new text type, add one !related_files/*.<ext> line.
related_files/**
!related_files/**/
# codex/ and eve/ are clones with their own .git. Git cannot descend into them, so
# the whitelist above leaves them as untracked directories and `git add` would
# record a gitlink with no .gitmodules to explain it. Name them explicitly; these
# rules must stay below the re-include, since the last match wins.
related_files/codex/
related_files/eve/
!related_files/*.typ
!related_files/*.tex
!related_files/*.bib
!related_files/*.md
!related_files/*.txt
!related_files/Makefile
# conversation/ holds the record of the chat that produced most of this corpus, plus
# the two scripts that regenerate it. The whitelist patterns above use a single `*`,
# which does not cross `/`, so this subdirectory needs its own two lines. mapping.json
# and outline.md are deliberately absent: decode_share.py regenerates both.
!related_files/conversation/*.md
!related_files/conversation/*.py
!related_files/conversation-openai-math-engineering-implications-2026-10-07/*.md
!related_files/conversation-harness-literature-and-multi-model-routing-2026-10-08/*.md

# 1006/ is the working directory for the 2026-10-06 model-society discussion. Only the
# Typst source is whitelisted: the human's own notes file in there stays untracked
# unless they say otherwise.
!related_files/1006/*.typ

# viz/: the TypeScript/Vite visualization of this corpus. Nothing under node_modules/
# or dist/ is tracked anywhere in this repo (verified: 0 tracked matches), so the
# patterns are safe at the top level.
node_modules/
dist/
