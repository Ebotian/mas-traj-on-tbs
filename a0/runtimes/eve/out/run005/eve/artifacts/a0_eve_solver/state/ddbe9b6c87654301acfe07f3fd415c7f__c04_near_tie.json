  "solution.py": "\"\"\"Near-tie variant of c01_good_hex: one radius shrunk by 1e-4.\n\nShrinking a radius can neither break the square bounds nor create an\noverlap, so the configuration stays valid and only the objective moves.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Iterable, List, Tuple\n\n# 26 equal circles of radius 0.0943046354170505, centres frozen by\n# tools/make_good_packing.py (see tools/good_packing_26.json).\nTABLE_26: List[Tuple[float, float, float]] = [\n    (0.09430473541705074, 0.36625249268324267, 0.0942046354170505),\n    (0.09430473541705074, 0.09430473541705074, 0.0943046354170505),\n    (0.5943049859758841, 0.23747737851250464, 0.0943046354170505),\n    (0.2629791171396117, 0.2818576738918528, 0.0943046354170505),\n    (0.9056952645829492, 0.9056952645829492, 0.0943046354170505),\n    (0.7170857937488478, 0.09430473541705074, 0.0943046354170505),\n    (0.09430473541705074, 0.5784001868369796, 0.0943046354170505),\n    (0.9056952645829492, 0.282914206251152, 0.0943046354170505),\n    (0.5749129173611398, 0.42508729339751467, 0.0943046354170505),\n    (0.9056952645829492, 0.5284763229147464, 0.0943046354170505),\n    (0.762522836360042, 0.405695264582949, 0.0943046354170505),\n    (0.28291470736881874, 0.09430473541705074, 0.0943046354170505),\n    (0.9056952645829492, 0.09430473541705074, 0.0943046354170505),\n    (0.6185745717251597, 0.7448566136817452, 0.0943046354170505),\n    (0.7277775348526201, 0.5910767537113892, 0.0943046354170505),\n    (0.30709344623441576, 0.5957318478116742, 0.0943046354170505),\n    (0.28291420625115193, 0.9056952645829492, 0.0943046354170505),\n    (0.9056952645829492, 0.7170857937488477, 0.0943046354170505),\n    (0.4014887779763118, 0.7590201016257718, 0.0943046354170505),\n    (0.520063349701472, 0.9056952645829492, 0.0943046354170505),\n    (0.09430473541705074, 0.9056952645829492, 0.0943046354170505),\n    (0.3863041786366744, 0.4245617792815206, 0.0943046354170505),\n    (0.4999999999999992, 0.5981814507245677, 0.0943046354170505),\n    (0.7170857937488477, 0.9056952645829492, 0.0943046354170505),\n    (0.18807581576240387, 0.7420477257099645, 0.0943046354170505),\n    (0.4715241782029202, 0.09430473541705074, 0.0943046354170505),\n]\n\n\ndef _fallback(n: int) -> List[Tuple[float, float, float]]:\n    \"\"\"Upstream's baseline construction, valid for any n (solution.py@b91c090).\"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    if n == 1:\n        return [(0.5, 0.5, 0.5)]\n    r = 1.0 / (4.0 * n)\n    step = 1.0 - 2.0 * r\n    return [(r + (i / (n - 1)) * step, r + (i / (n - 1)) * step, r) for i in range(n)]\n\n\ndef pack_circles(n: int = 26) -> Iterable[Tuple[float, float, float]]:\n    \"\"\"Return (x, y, r) triples for n circles in the unit square.\"\"\"\n    if n != 26:\n        return _fallback(n)\n    return list(TABLE_26)\n"
