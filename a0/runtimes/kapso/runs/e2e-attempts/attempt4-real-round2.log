[codex]         "fraction": args.fraction,
[codex]         "seed": args.seed,
[codex]     }
[codex]     try:
[codex]         source_component = check_evaluator_identity(locator)
[codex]         candidate_root = resolve_candidate(args.candidate)
[codex]         candidate = check_candidate_identity(locator, candidate_root)
