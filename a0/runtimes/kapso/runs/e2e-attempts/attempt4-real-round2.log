[codex] #!/usr/bin/env python
[codex] """KAPSO registered-evaluation entrypoint (the KAPSO-side execution of E*).
[codex] 
[codex] Installed by the A0 KAPSO adapter into a KAPSO workspace as
[codex] ``kapso_evaluation/kapso_eval.py`` and registered by KAPSO's own
[codex] ``EvaluationMaintainer`` (``execution/evaluation_maintainer/maintainer.py``).
[codex] KAPSO invokes it exactly as ``evaluation_command()`` composes it
[codex] (``maintainer.py:56-61``):
[codex] 
[codex]     python kapso_evaluation/kapso_eval.py --fidelity F --fraction X --seed S
[codex] 
[codex] with ``cwd`` set to the tree whose candidate is being measured (the session
[codex] folder for a session run, the branch worktree for a frame run, the workspace
[codex] root for the registration calibration).  This file is the *only* place where a
[codex] KAPSO score comes from; it never invents one.
[codex] 
[codex] Contract implemented here
[codex] -------------------------
[codex] 1. Evaluator identity.  The E* source files are re-hashed and compared with the
[codex]    digests the frozen ``EID*`` document recorded (``a0_locator.json``).  A
[codex]    mismatch aborts with exit 3 and no score, so the registered evaluator cannot
[codex]    silently run as a different E* than the one EID* names.  (This is the
[codex]    out-of-band evaluator-identity leg that KAPSO's own manifest triple does not
[codex]    carry: ``maintainer.py:64-83`` has no evaluator field.)
[codex] 2. Candidate identity.  The candidate's ``solution.py`` must hash to a digest in
[codex]    ``EID*``'s DataManifest (the frozen ``C*``).  A candidate outside the frozen
[codex]    set aborts with exit 3 unless the adapter explicitly declares that it is
[codex]    running an out-of-set injection (A0.2 seam rounds record this).
[codex] 3. One machine-readable line per run: ``KAPSO_EVAL_MANIFEST {...}`` carrying
[codex]    ``fidelity, fraction, seed, items, total_items`` (the keys KAPSO's
[codex]    ``parse_manifest_line`` requires) plus ``score`` **only when E* returned a
[codex]    measurement**.  For ``status=invalid`` / ``status=error`` the line omits
[codex]    ``score`` and the process exits non-zero, so KAPSO records *no* mechanical
[codex]    score of record instead of a numeric zero
[codex]    (``registered_evaluation.py:100-102`` returns None exactly for this shape).
[codex] 4. No writes anywhere but below the locator's ``state_root`` (E* writes below
[codex]    its own ``--state-dir``); nothing is written into the candidate tree.
[codex] """
[codex] 
[codex] from __future__ import annotations
[codex] 
[codex] import argparse
[codex] import hashlib
[codex] import json
[codex] import os
[codex] import subprocess
[codex] import sys
[codex] from pathlib import Path
[codex] 
[codex] HERE = Path(__file__).resolve().parent
[codex] LOCATOR_NAME = "a0_locator.json"
[codex] MANIFEST_MARKER = "KAPSO_EVAL_MANIFEST"
[codex] EXIT_CODES = {"ok": 0, "invalid": 2, "error": 3}
[codex] 
[codex] 
[codex] def fail(message: str, code: int = 3) -> int:
[codex]     """Abort without printing a manifest line: no measurement was taken."""
[codex]     print(f"kapso_eval: {message}", file=sys.stderr)
[codex]     return code
[codex] 
[codex] 
[codex] def sha256_file(path: Path) -> str:
[codex]     return hashlib.sha256(path.read_bytes()).hexdigest()
[codex] 
[codex] 
[codex] def load_locator() -> dict:
[codex]     locator_path = HERE / LOCATOR_NAME
[codex]     if not locator_path.is_file():
[codex]         raise SystemExit(
[codex]             f"kapso_eval: missing locator {locator_path}; the registered "
[codex]             "evaluation tree is not the one the adapter installed"
[codex]         )
[codex]     return json.loads(locator_path.read_text(encoding="utf-8"))
[codex] 
[codex] 
[codex] def check_evaluator_identity(locator: dict) -> str:
[codex]     """Re-hash E*'s own source against the EID* EvaluatorSource records."""
[codex]     e_star = locator["e_star"]
[codex]     root = Path(e_star["dir"])
[codex]     for record in e_star["source_records"]:
[codex]         path = root / record["path"]
[codex]         if not path.is_file():
[codex]             raise AssertionError(f"E* source file missing: {path}")
[codex]         digest = sha256_file(path)
[codex]         if digest != record["sha256"]:
[codex]             raise AssertionError(
[codex]                 f"E* source drifted: {record['path']} sha256 {digest} != "
[codex]                 f"{record['sha256']} recorded in EID* "
[codex]                 f"({locator['eid_star']})"
[codex]             )
[codex]     return locator["eid_star_components"]["EvaluatorSource"]
[codex] 
[codex] 
[codex] def resolve_candidate(arg: str | None) -> Path:
[codex]     root = Path(arg).resolve() if arg else Path.cwd()
[codex]     if root.is_file():
[codex]         root = root.parent
[codex]     solution = root / "solution.py"
[codex]     if not solution.is_file():
[codex]         raise AssertionError(f"no solution.py below {root}")
[codex]     return root
[codex] 
[codex] 
[codex] def check_candidate_identity(locator: dict, candidate_root: Path) -> dict:
[codex]     solution = candidate_root / "solution.py"
[codex]     digest = sha256_file(solution)
[codex]     members = locator["candidate_set"]["members"]
[codex]     for candidate_id, entry in members.items():
[codex]         if entry["solution_sha256"] == digest:
[codex]             return {"candidate_id": candidate_id, "in_frozen_set": True,
[codex]                     "solution_sha256": digest}
[codex]     if locator.get("allow_unfrozen_candidate") is True:
[codex]         return {"candidate_id": None, "in_frozen_set": False,
[codex]                 "solution_sha256": digest}
[codex]     raise AssertionError(
[codex]         f"solution.py sha256 {digest} is not a member of the frozen "
[codex]         f"candidate set C* recorded in EID* ({locator['eid_star']})"
[codex]     )
[codex] 
[codex] 
[codex] def main(argv: list[str] | None = None) -> int:
[codex]     parser = argparse.ArgumentParser(
[codex]         description="KAPSO registered evaluation over the frozen E*"
[codex]     )
[codex]     parser.add_argument("--fidelity", required=True, choices=("fast", "full"))
[codex]     parser.add_argument("--fraction", required=True, type=float)
[codex]     parser.add_argument("--seed", required=True, type=int)
[codex]     parser.add_argument(
[codex]         "--candidate",
[codex]         default=None,
[codex]         help="candidate root (default: the current working directory)",
[codex]     )
[codex]     args = parser.parse_args(argv)
[codex] 
[codex]     if not 0 < args.fraction <= 1:
[codex]         return fail(f"--fraction must be in (0, 1], got {args.fraction}", 1)
[codex] 
[codex]     locator = load_locator()
[codex]     e_star = locator["e_star"]
[codex]     theta = locator["theta_e_canonical"]
[codex]     metric = locator["metric"]
[codex]     # The E* state root is a property of the run, not of the evaluator: it is
[codex]     # overridden per run through the environment so that this tree's fingerprint
[codex]     # (KAPSO's EID_r) stays a function of the frozen EID* alone.
[codex]     state_root = Path(
[codex]         os.environ.get("A0_KAPSO_EVAL_STATE_ROOT")
[codex]         or locator["state_root_default"]
[codex]     )
[codex]     state_root.mkdir(parents=True, exist_ok=True)
[codex] 
[codex]     manifest: dict = {
