[codex] # --------------------------------------------------------------------------- #
[codex] # canonical serialisation
[codex] # --------------------------------------------------------------------------- #
[codex] 
[codex] def canonical_json(payload: object) -> str:
[codex]     """The single canonical byte form of any E* payload."""
[codex]     return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
[codex] 
[codex] 
[codex] def sha256_bytes(data: bytes) -> str:
[codex]     return hashlib.sha256(data).hexdigest()
[codex] 
[codex] 
[codex] def sha256_text(text: str) -> str:
[codex]     return sha256_bytes(text.encode("utf-8"))
[codex] 
[codex] 
[codex] def evaluator_source_digest() -> str:
[codex]     """Content digest of E*'s own source files (order- and path-independent)."""
[codex]     entries = []
[codex]     for name in SOURCE_FILES:
[codex]         data = (HERE / name).read_bytes()
[codex]         entries.append({"name": name, "sha256": sha256_bytes(data), "bytes": len(data)})
[codex]     return sha256_text(canonical_json(entries))
[codex] 
[codex] 
[codex] def source_file_digests() -> list[dict[str, Any]]:
[codex]     out = []
[codex]     for name in SOURCE_FILES:
[codex]         data = (HERE / name).read_bytes()
[codex]         out.append({"name": name, "bytes": len(data), "sha256": sha256_bytes(data)})
[codex]     return out
[codex] 
[codex] 
[codex] # --------------------------------------------------------------------------- #
[codex] # theta_E and the audit subsample
[codex] # --------------------------------------------------------------------------- #
[codex] 
[codex] def audit_sample(n: int, size: int, seed: int) -> list[int]:
[codex]     """Deterministic decimation of the item set, driven only by `seed`.
[codex] 
[codex]     Items are ordered by sha256(f"e_star/v1|seed=<seed>|n=<n>|index=<i>") with
[codex]     the index as tie-break, which is reproducible on any Python version and
[codex]     platform (unlike `random.Random.sample`, whose algorithm is a CPython
[codex]     implementation detail), then the first `size` indices are taken in ascending
[codex]     order.  `size >= n` returns every item.
[codex]     """
[codex]     if size >= n:
[codex]         return list(range(n))
[codex]     if size <= 0:
[codex]         return []
[codex]     keyed = sorted(
[codex]         range(n),
[codex]         key=lambda index: (
[codex]             sha256_text(f"e_star/v1|seed={int(seed)}|n={int(n)}|index={index}"),
[codex]             index,
[codex]         ),
[codex]     )
[codex]     return sorted(keyed[:size])
[codex] 
[codex] 
[codex] def resolve_theta(args: argparse.Namespace) -> dict[str, Any]:
[codex]     fidelity = args.fidelity
[codex]     if args.fraction is None:
[codex]         fraction = 1.0 if fidelity == "full" else DEFAULT_FAST_FRACTION
[codex]     else:
[codex]         fraction = float(args.fraction)
[codex]     if not 0.0 < fraction <= 1.0:
[codex]         raise ValueError(f"--fraction must be in (0, 1], got {fraction!r}")
[codex]     if fidelity == "full" and fraction != 1.0:
[codex]         raise ValueError(
[codex]             "--fidelity full evaluates every item; pass --fraction 1.0 "
[codex]             f"(or use --fidelity fast) instead of {fraction!r}"
[codex]         )
[codex]     if int(args.n) <= 0:
[codex]         raise ValueError(f"--n must be positive, got {args.n!r}")
[codex]     if int(args.runs) <= 0:
[codex]         raise ValueError(f"--runs must be positive, got {args.runs!r}")
[codex]     return {
[codex]         "seed": int(args.seed),
[codex]         "fidelity": fidelity,
[codex]         "fraction": float(fraction),
[codex]         "n": int(args.n),
[codex]         "runs": int(args.runs),
[codex]         "runtime_budget_ms": float(args.runtime_budget_ms),
[codex]         "timeout_s": float(args.timeout_s),
[codex]     }
[codex] 
[codex] 
[codex] def audited_item_count(theta: Mapping[str, Any]) -> int:
[codex]     n = int(theta["n"])
[codex]     if theta["fidelity"] == "full":
[codex]         return n
[codex]     return max(1, min(n, int(round(float(theta["fraction"]) * n))))
[codex] 
[codex] 
[codex] def theta_digest(theta: Mapping[str, Any]) -> str:
[codex]     return sha256_text(canonical_json(dict(theta)))[:16]
[codex] 
[codex] 
[codex] # --------------------------------------------------------------------------- #
[codex] # candidate resolution and state root
[codex] # --------------------------------------------------------------------------- #
[codex] 
[codex] def resolve_candidate(path_str: str) -> tuple[Path, bytes]:
[codex]     """Return the candidate source file and its exact bytes.
[codex] 
[codex]     `path` may be a `solution.py`-style file or a directory containing one.
[codex]     """
[codex]     path = Path(path_str).expanduser()
[codex]     if path.is_dir():
[codex]         path = path / "solution.py"
[codex]     if not path.is_file():
[codex]         raise FileNotFoundError(
[codex]             f"candidate not found: {path} (expected a solution.py file or a "
[codex]             "directory containing one)"
[codex]         )
[codex]     return path, path.read_bytes()
[codex] 
[codex] 
[codex] def default_state_root() -> Path:
[codex]     return Path(tempfile.gettempdir()) / "e-star-state"
[codex] 
[codex] 
[codex] def state_dir_for(root: Path, candidate_sha256: str, theta: Mapping[str, Any]) -> Path:
[codex]     """State is keyed by candidate *content* and theta_E, never by path."""
[codex]     return root / f"{candidate_sha256[:16]}-{theta_digest(theta)}"
[codex] 
[codex] 
[codex] # --------------------------------------------------------------------------- #
[codex] # isolated execution
[codex] # --------------------------------------------------------------------------- #
[codex] 
[codex] def child_environment(state_dir: Path) -> dict[str, str]:
[codex]     """A fully specified environment: nothing of the caller's can leak in."""
[codex]     for sub in ("home", "tmp", "cwd"):
[codex]         (state_dir / sub).mkdir(parents=True, exist_ok=True)
[codex]     return {
[codex]         "PATH": "",
[codex]         "PYTHONPATH": "",
[codex]         "PYTHONDONTWRITEBYTECODE": "1",
[codex]         "PYTHONHASHSEED": "0",
[codex]         "PYTHONNOUSERSITE": "1",
[codex]         "PYTHONIOENCODING": "utf-8",
[codex]         "LC_ALL": "C",
[codex]         "LANG": "C",
[codex]         "HOME": str(state_dir / "home"),
[codex]         "TMPDIR": str(state_dir / "tmp"),
[codex]     }
[codex] 
[codex] 
[codex] def run_child(
[codex]     *,
[codex]     solution_copy: Path,
[codex]     run_dir: Path,
[codex]     theta: Mapping[str, Any],
[codex] 
[codex] exec
[codex] /bin/bash -lc "sed -n '260,620p' /home/ebt/rsi-dev/a0/tasks/circle-packing/e_star.py" in /home/ebt/rsi-dev/a0/runtimes/kapso/runs/e2e-mechanical/workspace/sessions/generic_exp_0
[codex]  succeeded in 0ms:
[codex]     theta: Mapping[str, Any],
[codex]     state_dir: Path,
[codex] ) -> dict[str, Any]:
[codex]     """Execute the candidate in a child process; return the raw artifacts.
[codex] 
[codex]     This process never imports candidate code.  The child writes one artifact
[codex]     file per call plus a done marker; a missing marker means the candidate
[codex]     terminated the runner, which is reported as an error rather than a score.
[codex]     The run directory is emptied first so that no leftover state from an earlier
[codex]     invocation can be mistaken for a measurement.
[codex]     """
[codex]     shutil.rmtree(run_dir, ignore_errors=True)
[codex]     run_dir.mkdir(parents=True, exist_ok=True)
[codex]     command = [
[codex]         sys.executable,
[codex]         str(CHILD_PATH),
[codex]         "--solution",
[codex]         str(solution_copy),
[codex]         "--n",
[codex]         str(int(theta["n"])),
[codex]         "--runs",
[codex]         str(int(theta["runs"])),
[codex]         "--run-dir",
[codex]         str(run_dir),
[codex]     ]
[codex]     info: dict[str, Any] = {
[codex]         "command": command,
[codex]         "returncode": None,
[codex]         "timed_out": False,
[codex]         "stdout": "",
[codex]         "stderr": "",
[codex]         "runs": [],
[codex]         "done": None,
[codex]     }
[codex]     try:
[codex]         completed = subprocess.run(
[codex]             command,
[codex]             cwd=str(state_dir / "cwd"),
[codex]             env=child_environment(state_dir),
[codex]             capture_output=True,
[codex]             timeout=float(theta["timeout_s"]),
[codex]             check=False,
[codex]         )
[codex]         info["returncode"] = completed.returncode
[codex]         info["stdout"] = completed.stdout.decode("utf-8", "replace")[-4000:]
[codex]         info["stderr"] = completed.stderr.decode("utf-8", "replace")[-4000:]
[codex]     except subprocess.TimeoutExpired as exc:
[codex]         info["timed_out"] = True
[codex]         info["stdout"] = (exc.stdout or b"").decode("utf-8", "replace")[-4000:]
[codex]         info["stderr"] = (exc.stderr or b"").decode("utf-8", "replace")[-4000:]
[codex] 
[codex]     done_path = run_dir / "child_done.json"
[codex]     if done_path.is_file():
[codex]         try:
[codex]             info["done"] = json.loads(done_path.read_text(encoding="utf-8"))
[codex]         except json.JSONDecodeError as exc:
[codex]             info["done_error"] = f"unreadable done marker: {exc}"
[codex]     for index in range(int(theta["runs"])):
[codex]         run_path = run_dir / f"run_{index:02d}.json"
[codex]         if run_path.is_file():
[codex]             try:
[codex]                 info["runs"].append(json.loads(run_path.read_text(encoding="utf-8")))
[codex]             except json.JSONDecodeError as exc:
[codex]                 info["runs"].append({"run": index, "error": f"unreadable artifact: {exc}"})
[codex]     return info
[codex] 
[codex] 
[codex] # --------------------------------------------------------------------------- #
[codex] # scoring (parent side, on artifacts only)
[codex] # --------------------------------------------------------------------------- #
[codex] 
[codex] def coerce_circles(entries: object) -> tuple[list[tuple[float, float, float]] | None, str | None]:
[codex]     """Mirror upstream `_coerce_circle` / `_coerce_circles` (evaluate.py:75-97)."""
[codex]     if not isinstance(entries, list):
[codex]         return None, "the return value is not an iterable of circle entries"
[codex]     circles: list[tuple[float, float, float]] = []
[codex]     for index, entry in enumerate(entries):
[codex]         if not isinstance(entry, list) or len(entry) != 3:
[codex]             return None, f"circle #{index} is not an iterable of length 3: {entry!r}"
[codex]         try:
[codex]             x, y, r = float(entry[0]), float(entry[1]), float(entry[2])
[codex]         except (TypeError, ValueError):
[codex]             return None, f"circle #{index} contains non-numeric values: {entry!r}"
[codex]         if not (math.isfinite(x) and math.isfinite(y) and math.isfinite(r)):
[codex]             return None, f"circle #{index} contains non-finite values: {entry!r}"
[codex]         circles.append((x, y, r))
[codex]     return circles, None
[codex] 
[codex] 
[codex] def _percentile(values: Sequence[float], percentile: float) -> float:
[codex]     ordered = sorted(float(item) for item in values)
[codex]     if len(ordered) == 1:
[codex]         return ordered[0]
[codex]     rank = max(0.0, min(1.0, float(percentile))) * (len(ordered) - 1)
[codex]     lower = int(rank)
[codex]     upper = min(len(ordered) - 1, lower + 1)
[codex]     if lower == upper:
[codex]         return ordered[lower]
[codex]     fraction = rank - lower
[codex]     return ordered[lower] + (ordered[upper] - ordered[lower]) * fraction
[codex] 
[codex] 
[codex] def p50_ms(durations_s: Sequence[float]) -> float:
[codex]     if not durations_s:
[codex]         return 0.0
[codex]     return _percentile([float(item) * 1000.0 for item in durations_s], 0.5)
[codex] 
[codex] 
[codex] def in_bounds(circle: tuple[float, float, float]) -> bool:
[codex]     x, y, r = circle
[codex]     return (
[codex]         x - r >= UNIT_SQUARE_MIN - EPS
[codex]         and x + r <= UNIT_SQUARE_MAX + EPS
[codex]         and y - r >= UNIT_SQUARE_MIN - EPS
[codex]         and y + r <= UNIT_SQUARE_MAX + EPS
[codex]     )
[codex] 
[codex] 
[codex] def structure_fields(
[codex]     circles: Sequence[tuple[float, float, float]], sample: Sequence[int], n: int
[codex] ) -> dict[str, Any]:
[codex]     """Structural fields computed over the audited subset of the item set.
[codex] 
[codex]     `sum_radii` and `packing_density` follow upstream `_compute_metrics`
[codex]     (evaluate.py:133-145) and always cover *every* returned circle;
[codex]     `overlap_count`, `min_gap` and `min_boundary_margin` are audit-scoped.
[codex]     """
[codex]     sampled = [circles[i] for i in sample if 0 <= i < len(circles)]
[codex] 
[codex]     # Bit-for-bit upstream `_compute_metrics` (evaluate.py:137-140): the same
[codex]     # `sum(...)` expressions, deliberately, because CPython >= 3.12 sums floats
[codex]     # with compensated summation while an explicit accumulator loop does not.
[codex]     # Mirroring the expression makes E* bit-identical to the plugin on whatever
[codex]     # interpreter the study pins, instead of merely close.
[codex]     total_area = sum(math.pi * (r**2) for _, _, r in circles)
[codex]     sum_radii = sum(r for _, _, r in circles)
[codex] 
[codex]     min_boundary_margin: float | None = None
[codex]     for x, y, r in sampled:
[codex]         value = min(x - r, y - r, UNIT_SQUARE_MAX - (x + r), UNIT_SQUARE_MAX - (y + r))
[codex]         min_boundary_margin = value if min_boundary_margin is None else min(min_boundary_margin, value)
[codex] 
[codex]     overlap_count = 0
[codex]     min_gap: float | None = None
[codex]     pairs_audited = 0
[codex]     for a in range(len(sampled)):
[codex]         x1, y1, r1 = sampled[a]
[codex]         for b in range(a + 1, len(sampled)):
[codex]             x2, y2, r2 = sampled[b]
[codex]             gap = math.hypot(x2 - x1, y2 - y1) - (r1 + r2)
[codex]             pairs_audited += 1
[codex]             min_gap = gap if min_gap is None else min(min_gap, gap)
[codex]             if gap < -EPS:
[codex]                 overlap_count += 1
[codex] 
[codex]     return {
[codex]         "num_circles": len(circles),
[codex]         "num_circles_expected": n,
[codex]         "sum_radii": sum_radii,
[codex]         "packing_density": total_area,  # container area is 1.0
[codex]         "overlap_count": overlap_count,
[codex]         "min_gap": min_gap,
[codex]         "min_boundary_margin": min_boundary_margin,
[codex]         "pairs_audited": pairs_audited,
[codex]     }
[codex] 
[codex] 
[codex] def build_outcome(
[codex]     *,
[codex]     theta: Mapping[str, Any],
[codex]     candidate_sha256: str,
[codex]     candidate_bytes: int,
[codex]     source_digest: str,
[codex]     child: Mapping[str, Any],
[codex] ) -> dict[str, Any]:
[codex]     n = int(theta["n"])
[codex]     sample = audit_sample(n, audited_item_count(theta), int(theta["seed"]))
[codex]     total_pairs = n * (n - 1) // 2
[codex] 
[codex]     checks: list[dict[str, Any]] = []
[codex] 
[codex]     def check(name: str, passed: bool, detail: Any) -> bool:
[codex]         checks.append({"name": name, "passed": bool(passed), "detail": detail})
[codex]         return bool(passed)
[codex] 
[codex]     status = STATUS_ERROR
[codex]     failure: dict[str, str] | None = None
[codex]     objective: dict[str, Any] | None = None
[codex]     structure: dict[str, Any] | None = None
[codex]     runs = list(child.get("runs", []))
[codex]     durations = [float(run.get("duration_s", 0.0)) for run in runs]
[codex] 
[codex]     done = child.get("done")
[codex]     artifacts_ok = check(
[codex]         "child_artifacts_complete",
[codex]         done is not None,
[codex]         {
[codex]             "runs_requested": int(theta["runs"]),
[codex]             "runs_written": None if done is None else done.get("runs_written"),
[codex]             "returncode": child.get("returncode"),
[codex]             "timed_out": bool(child.get("timed_out")),
[codex]         },
[codex]     )
[codex] 
[codex]     if not artifacts_ok:
[codex]         failure = {
[codex]             "kind": "timeout" if child.get("timed_out") else "child_terminated_early",
[codex]             "message": (
[codex]                 f"candidate exceeded the {theta['timeout_s']} s wall-clock budget"
[codex]                 if child.get("timed_out")
[codex]                 else "the isolated runner did not write its done marker; no measurement exists"
[codex]             ),
[codex]         }
[codex]     elif done.get("import_error"):
[codex]         check("candidate_module_imports", False, done["import_error"])
[codex]         failure = {"kind": "candidate_import_failed", "message": str(done["import_error"])}
[codex]     elif done.get("entry_error"):
[codex]         check("candidate_module_imports", True, None)
[codex]         check("candidate_defines_entrypoint", False, done["entry_error"])
[codex]         failure = {"kind": "candidate_entrypoint_missing", "message": str(done["entry_error"])}
[codex]     else:
[codex]         check("candidate_module_imports", True, None)
[codex]         check("candidate_defines_entrypoint", True, done.get("entry_type"))
[codex]         runs_ok = check(
[codex]             "all_runs_recorded", len(runs) == int(theta["runs"]),
[codex]             {"recorded": len(runs), "expected": int(theta["runs"])},
[codex]         )
[codex]         if not runs_ok:
[codex]             failure = {"kind": "child_terminated_early", "message": "artifact set is incomplete"}
[codex]         else:
[codex]             call_errors = [run.get("error") for run in runs if run.get("error")]
[codex]             call_ok = check("candidate_call_succeeds", not call_errors, call_errors[0] if call_errors else None)
[codex]             if not call_ok:
[codex]                 failure = {"kind": "candidate_call_raised", "message": str(call_errors[0])}
[codex]             else:
[codex]                 per_run: list[list[tuple[float, float, float]] | None] = []
[codex]                 parse_error: str | None = None
[codex]                 for index, run in enumerate(runs):
[codex]                     circles_i, error_i = coerce_circles(run.get("value"))
[codex]                     per_run.append(circles_i)
[codex]                     if error_i is not None and parse_error is None:
[codex]                         parse_error = f"run {index}: {error_i}"
[codex]                 circles = per_run[0]
[codex]                 parse_ok = check("output_parses_as_triples", parse_error is None, parse_error)
[codex]                 if not parse_ok or circles is None:
[codex]                     failure = {"kind": "malformed_output", "message": str(parse_error)}
[codex]                 else:
[codex]                     structure = structure_fields(circles, sample, n)
[codex]                     sampled_radii = [circles[i][2] for i in sample if i < len(circles)]
[codex]                     count_ok = check(
[codex]                         "count_equals_n",
[codex]                         len(circles) == n,
[codex]                         {"num_circles": len(circles), "expected": n},
[codex]                     )
[codex]                     positive_ok = check(
[codex]                         "radius_positive_check",
[codex]                         all(r > 0.0 for r in sampled_radii),
[codex]                         {"items_audited": len(sampled_radii), "min_radius": min(sampled_radii) if sampled_radii else None},
[codex]                     )
[codex]                     bounds_ok = check(
[codex]                         "bounds_check",
[codex]                         all(in_bounds(circles[i]) for i in sample if i < len(circles)),
[codex]                         {"items_audited": len(sampled_radii), "min_boundary_margin": structure["min_boundary_margin"]},
[codex]                     )
[codex]                     overlap_ok = check(
[codex]                         "overlap_check",
[codex]                         structure["overlap_count"] == 0,
[codex]                         {
[codex]                             "pairs_audited": structure["pairs_audited"],
[codex]                             "overlap_count": structure["overlap_count"],
[codex]                             "min_gap": structure["min_gap"],
[codex]                         },
[codex]                     )
[codex]                     deterministic_ok = check(
[codex]                         "determinism_check",
[codex]                         _deterministic(per_run),
[codex]                         {"runs": len(per_run), "checked": len(per_run) > 1},
[codex]                     )
[codex]                     budget_enabled = float(theta["runtime_budget_ms"]) > 0.0
[codex]                     budget_ok = check(
[codex]                         "runtime_budget_check",
[codex]                         p50_ms(durations) <= float(theta["runtime_budget_ms"]) if budget_enabled else True,
[codex]                         {
[codex]                             "enabled": budget_enabled,
[codex]                             "budget_ms": float(theta["runtime_budget_ms"]),
[codex]                             "runs": len(runs),
[codex]                             # The measured p50 itself is wall-clock dependent and
[codex]                             # therefore lives in the state root (resources.json),
[codex]                             # never in the canonical Outcome.
[codex]                             "measurement": "resources.json",
[codex]                         },
