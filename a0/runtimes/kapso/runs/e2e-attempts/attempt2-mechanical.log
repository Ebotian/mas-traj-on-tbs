[codex] STATUS_OK = "ok"
[codex] STATUS_INVALID = "invalid"
[codex] STATUS_ERROR = "error"
[codex] EXIT_CODES = {STATUS_OK: 0, STATUS_INVALID: 2, STATUS_ERROR: 3}
