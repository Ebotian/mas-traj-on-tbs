[codex]                         failure = {"kind": "invalid_configuration", "message": _first_failure(checks)}
[codex]                     elif not deterministic_ok:
[codex]                         status = STATUS_ERROR
[codex]                         failure = {
[codex]                             "kind": "non_deterministic",
[codex]                             "message": "repeated calls returned different circle sets",
