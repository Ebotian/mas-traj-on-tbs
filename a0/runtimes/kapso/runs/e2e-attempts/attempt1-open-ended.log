[codex] def in_bounds(circle: tuple[float, float, float]) -> bool:
[codex]     x, y, r = circle
[codex]     return (
[codex]         x - r >= UNIT_SQUARE_MIN - EPS
[codex]         and x + r <= UNIT_SQUARE_MAX + EPS
[codex]         and y - r >= UNIT_SQUARE_MIN - EPS
[codex]         and y + r <= UNIT_SQUARE_MAX + EPS
[codex]     )
