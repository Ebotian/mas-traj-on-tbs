[codex] def structure_fields(
[codex]     circles: Sequence[tuple[float, float, float]], sample: Sequence[int], n: int
[codex] ) -> dict[str, Any]:
[codex]     """Structural fields computed over the audited subset of the item set.
[codex] 
[codex]     `sum_radii` and `packing_density` follow upstream `_compute_metrics`
[codex]     (evaluate.py:133-145) and always cover *every* returned circle;
[codex]     `overlap_count`, `min_gap` and `min_boundary_margin` are audit-scoped.
[codex]     """
[codex]     sampled = [circles[i] for i in sample if 0 <= i < len(circles)]
[codex] 
[codex]     # Bit-for-bit upstream `_compute_metrics` (evaluate.py:137-140): the same
[codex]     # `sum(...)` expressions, deliberately, because CPython >= 3.12 sums floats
[codex]     # with compensated summation while an explicit accumulator loop does not.
[codex]     # Mirroring the expression makes E* bit-identical to the plugin on whatever
[codex]     # interpreter the study pins, instead of merely close.
[codex]     total_area = sum(math.pi * (r**2) for _, _, r in circles)
[codex]     sum_radii = sum(r for _, _, r in circles)
[codex] 
[codex]     min_boundary_margin: float | None = None
[codex]     for x, y, r in sampled:
[codex]         value = min(x - r, y - r, UNIT_SQUARE_MAX - (x + r), UNIT_SQUARE_MAX - (y + r))
[codex]         min_boundary_margin = value if min_boundary_margin is None else min(min_boundary_margin, value)
[codex] 
[codex]     overlap_count = 0
[codex]     min_gap: float | None = None
[codex]     pairs_audited = 0
[codex]     for a in range(len(sampled)):
[codex]         x1, y1, r1 = sampled[a]
[codex]         for b in range(a + 1, len(sampled)):
[codex]             x2, y2, r2 = sampled[b]
[codex]             gap = math.hypot(x2 - x1, y2 - y1) - (r1 + r2)
[codex]             pairs_audited += 1
[codex]             min_gap = gap if min_gap is None else min(min_gap, gap)
[codex]             if gap < -EPS:
[codex]                 overlap_count += 1
[codex] 
[codex]     return {
[codex]         "num_circles": len(circles),
[codex]         "num_circles_expected": n,
[codex]         "sum_radii": sum_radii,
[codex]         "packing_density": total_area,  # container area is 1.0
[codex]         "overlap_count": overlap_count,
[codex]         "min_gap": min_gap,
[codex]         "min_boundary_margin": min_boundary_margin,
[codex]         "pairs_audited": pairs_audited,
[codex]     }
[codex] 
