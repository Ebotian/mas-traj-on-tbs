[codex]     if not callable(entry):
[codex]         done["entry_error"] = f"module does not define a callable {ENTRY_NAME!r}"
[codex]         _write(os.path.join(run_dir, DONE_NAME), done)
[codex]         return 0
[codex] 
[codex]     for index in range(int(args.runs)):
[codex]         record: dict[str, object] = {"run": index, "error": None, "value": None, "length": None}
[codex]         started = time.perf_counter()
[codex]         try:
[codex]             raw = entry(args.n)
[codex]             value, length = _materialize(raw)
[codex]             record["value"] = value
[codex]             record["length"] = length
[codex]         except BaseException as exc:  # noqa: BLE001 - a candidate may raise anything
[codex]             record["error"] = f"{type(exc).__name__}: {exc}"
[codex]         record["duration_s"] = time.perf_counter() - started
[codex]         _write(os.path.join(run_dir, RUN_TEMPLATE.format(index=index)), record)
[codex]         done["runs_written"] = index + 1
[codex] 
[codex]     _write(os.path.join(run_dir, DONE_NAME), done)
[codex]     return 0
