[codex] """Isolated candidate runner used by E* (`e_star.py`).
[codex] 
[codex] This process is the ONLY place candidate code is ever imported.  It performs no
[codex] validation and no scoring: it calls `pack_circles(n)` `--runs` times, records the
[codex] raw return value of every call plus its wall-clock duration, and writes one
[codex] artifact file per run into `--run-dir`.  All judgement is made by the parent
[codex] process from those artifacts, which is what keeps a candidate from being able to
[codex] monkey-patch the evaluation at runtime.
[codex] 
[codex] Artifacts are written with write-to-temp + rename, one file per run, plus a
[codex] `child_done.json` marker written only after the last run.  A candidate that
[codex] kills this process (os._exit, segfault, hang) therefore leaves an incomplete
[codex] artifact set and no done marker, which the parent reports as an evaluation
[codex] error rather than as a score.
[codex] """
[codex] 
[codex] from __future__ import annotations
[codex] 
[codex] import argparse
[codex] import importlib.util
[codex] import json
[codex] import os
[codex] import sys
[codex] import time
[codex] 
[codex] DONE_NAME = "child_done.json"
[codex] RUN_TEMPLATE = "run_{index:02d}.json"
[codex] MODULE_NAME = "circle_packing_solution"
[codex] ENTRY_NAME = "pack_circles"
[codex] 
[codex] 
[codex] def _jsonable(value: object) -> object:
[codex]     """Keep JSON scalars verbatim; anything else becomes its repr.
[codex] 
[codex]     The parent re-coerces with `float()`, mirroring upstream's
[codex]     `_coerce_circle`; a repr that happens to parse as a float is accepted there
[codex]     exactly as upstream would accept the original object.
[codex]     """
[codex]     if value is None or isinstance(value, (int, float, bool, str)):
[codex]         return value
[codex]     return repr(value)
[codex] 
[codex] 
[codex] def _materialize(raw: object) -> tuple[list[object], int]:
[codex]     """Turn the candidate's return value into a JSON-able list of entries."""
[codex]     entries = list(raw)  # type: ignore[call-overload]
[codex]     out: list[object] = []
[codex]     for entry in entries:
[codex]         try:
[codex]             sequence = list(entry)  # type: ignore[call-overload]
[codex]         except TypeError:
[codex]             out.append(_jsonable(entry))
[codex]             continue
[codex]         out.append([_jsonable(value) for value in sequence])
[codex]     return out, len(entries)
[codex] 
[codex] 
[codex] def _write(path: str, payload: object) -> None:
[codex]     tmp = f"{path}.tmp"
[codex]     with open(tmp, "w", encoding="utf-8") as handle:
[codex]         json.dump(payload, handle, ensure_ascii=False, sort_keys=True, allow_nan=True)
[codex]         handle.flush()
[codex]         os.fsync(handle.fileno())
[codex]     os.replace(tmp, path)
[codex] 
[codex] 
[codex] def main(argv: list[str] | None = None) -> int:
[codex]     parser = argparse.ArgumentParser(description="E* isolated candidate runner.")
[codex]     parser.add_argument("--solution", required=True)
[codex]     parser.add_argument("--n", type=int, required=True)
[codex]     parser.add_argument("--runs", type=int, required=True)
[codex]     parser.add_argument("--run-dir", required=True)
[codex]     args = parser.parse_args(argv)
[codex] 
[codex]     run_dir = os.path.abspath(args.run_dir)
[codex]     done = {
[codex]         "runs_requested": int(args.runs),
[codex]         "runs_written": 0,
[codex]         "import_error": None,
[codex]         "entry_error": None,
[codex]         "entry_type": None,
[codex]     }
[codex] 
[codex]     spec = importlib.util.spec_from_file_location(MODULE_NAME, args.solution)
[codex]     if spec is None or spec.loader is None:
[codex]         done["import_error"] = f"could not create an import spec for {args.solution!r}"
[codex]         _write(os.path.join(run_dir, DONE_NAME), done)
[codex]         return 0
[codex] 
[codex]     module = importlib.util.module_from_spec(spec)
[codex]     sys.modules[MODULE_NAME] = module
[codex]     try:
[codex]         spec.loader.exec_module(module)  # type: ignore[union-attr]
[codex]     except BaseException as exc:  # noqa: BLE001 - a candidate may raise anything
