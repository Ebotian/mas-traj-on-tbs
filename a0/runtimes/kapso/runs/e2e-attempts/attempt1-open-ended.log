[codex] 
[codex] def pack_circles(n: int = 26) -> Iterable[Tuple[float, float, float]]:
[codex]     """
[codex]     Construct a very simple packing of n disjoint circles in the unit square.
[codex] 
[codex]     - For n == 1 this returns a single circle of radius 0.5 centred at (0.5, 0.5).
[codex]     - For n >= 2 this returns n equal-radius circles placed along the main diagonal
[codex]       of the square, from the bottom-left corner towards the top-right corner.
[codex] 
[codex]     The construction is deliberately simple and only aims to produce a valid
[codex]     configuration; it is not intended to be close to optimal for the objective that
[codex]     maximises the sum of all radii.
[codex]     """
[codex]     if n <= 0:
[codex]         raise ValueError("n must be a positive integer.")
[codex] 
[codex]     if n == 1:
[codex]         # One circle touching all four sides of the square.
[codex]         return [(0.5, 0.5, 0.5)]
[codex] 
[codex]     # For n >= 2, choose a small radius that guarantees non-overlap and that all circles
[codex]     # remain inside the unit square. The factor 4 * n keeps centres well separated along
[codex]     # the diagonal.
[codex]     r = 1.0 / (4.0 * n)
[codex] 
[codex]     # Place n centres evenly along the main diagonal segment from (r, r) to (1 - r, 1 - r).
[codex]     positions = [i / (n - 1) for i in range(n)]
[codex] 
[codex]     step = 1.0 - 2.0 * r
[codex]     circles: List[Tuple[float, float, float]] = []
[codex]     for t in positions:
[codex]         x = r + t * step
[codex]         y = r + t * step
[codex]         circles.append((x, y, r))
[codex] 
[codex]     return circles
[codex] 
