[codex] def build_parser() -> argparse.ArgumentParser:
[codex]     parser = argparse.ArgumentParser(
[codex]         prog="e_star.py",
[codex]         description="E*: frozen reference evaluator for the circle-packing plumbing task.",
[codex]     )
[codex]     sub = parser.add_subparsers(dest="command", required=True)
[codex] 
[codex]     evaluate = sub.add_parser("evaluate", help="evaluate one candidate")
[codex]     evaluate.add_argument("--candidate", required=True, help="solution.py or a directory containing it")
[codex]     evaluate.add_argument("--seed", type=int, default=DEFAULT_SEED, help="evaluator seed (theta_E)")
[codex]     evaluate.add_argument("--fidelity", choices=("full", "fast"), default="full")
[codex]     evaluate.add_argument("--fraction", type=float, default=None, help="fast-tier audit fraction in (0, 1]")
[codex]     evaluate.add_argument("--n", type=int, default=DEFAULT_NUM_CIRCLES, help="circles requested from the candidate")
[codex]     evaluate.add_argument("--runs", type=int, default=DEFAULT_RUNTIME_RUNS, help="repeated calls per evaluation")
[codex]     evaluate.add_argument(
[codex]         "--runtime-budget-ms",
[codex]         type=float,
[codex]         default=DEFAULT_RUNTIME_BUDGET_MS,
[codex]         help="p50 runtime budget in ms; <= 0 disables the check",
[codex]     )
[codex]     evaluate.add_argument(
[codex]         "--timeout-s", type=float, default=DEFAULT_TIMEOUT_S, help="wall-clock budget for the child process"
[codex]     )
[codex]     evaluate.add_argument("--out", required=True, help="path of the canonical Outcome JSON to write")
[codex]     evaluate.add_argument(
[codex]         "--emit-resources",
[codex]         default=None,
[codex]         help="optional path for the timing sidecar (timings never enter the canonical Outcome)",
[codex]     )
[codex]     evaluate.add_argument(
[codex]         "--state-dir",
[codex]         default=None,
[codex]         help="state root for run records (default: <tmp>/e-star-state); never written inside a candidate tree",
[codex]     )
[codex]     evaluate.set_defaults(func=cmd_evaluate)
[codex] 
[codex]     digest = sub.add_parser("digest", help="print E* identity material (source digests, defaults)")
[codex]     digest.set_defaults(func=cmd_digest)
