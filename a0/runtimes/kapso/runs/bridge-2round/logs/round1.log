[codex] def _fallback(n: int) -> List[Tuple[float, float, float]]:
[codex]     """Upstream's baseline construction, valid for any n (solution.py@b91c090)."""
[codex]     if n <= 0:
[codex]         raise ValueError("n must be a positive integer.")
[codex]     if n == 1:
[codex]         return [(0.5, 0.5, 0.5)]
[codex]     r = 1.0 / (4.0 * n)
[codex]     step = 1.0 - 2.0 * r
[codex]     return [(r + (i / (n - 1)) * step, r + (i / (n - 1)) * step, r) for i in range(n)]
